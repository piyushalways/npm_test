/* Original I2C configuration */
&i2c21_default {
    group1 {
        bias-pull-up;
    };
};

&i2c21 {
    status = "okay";
};

/* PMIC interrupt configuration */
&npm1300_ek_pmic {
    host-int-gpios = <&gpio1 10 0>;
    pmic-int-pin = <3>;

    /* Add GPIO controller node */
    npm1300_ek_gpio: gpio-controller {
        compatible = "nordic,npm1300-gpio";
        gpio-controller;
        #gpio-cells = <2>;
        ngpios = <5>;
        status = "okay";
    };
};

&npm1300_ek_buck1 {
	/* Set to your required rail; example: 1.8 V */
	regulator-min-microvolt = <3000000>;
	regulator-max-microvolt = <3000000>;

	/* Make sure it’s on at boot (and kept on) */
	regulator-boot-on;
	regulator-always-on;
	/* Enable forced PWM mode */
	regulator-allowed-modes = <NPM1300_BUCK_MODE_PFM>;
	regulator-initial-mode = <NPM1300_BUCK_MODE_PFM>;
	status = "okay";
};

&npm1300_ek_buck2 {
	/* Set to your required rail; example: 3.3 V */
	regulator-min-microvolt = <2200000>;
	regulator-max-microvolt = <2200000>;

	/* Make sure it's on at boot (and kept on) */
	regulator-boot-on;
	regulator-always-on;
	/* Enable forced PWM mode */
	regulator-allowed-modes = <NPM1300_BUCK_MODE_PFM>;
	regulator-initial-mode = <NPM1300_BUCK_MODE_PFM>;
	status = "okay";
};

/* Configure LDO1 in Load Switch mode */
&npm1300_ek_ldo1 {
	regulator-allowed-modes = <NPM1300_LDSW_MODE_LDSW>;
	regulator-initial-mode = <NPM1300_LDSW_MODE_LDSW>;
	regulator-boot-on;
	status = "okay";
};

/* Configure LDO2 as a regulated 3.3 V rail.
 * Output = 3.3 V when enabled, 0 V when disabled.
 * Control at runtime with regulator_enable() / regulator_disable().
 */
&npm1300_ek_ldo2 {
	regulator-allowed-modes = <NPM1300_LDSW_MODE_LDSW>;
	regulator-initial-mode = <NPM1300_LDSW_MODE_LDSW>;
	regulator-boot-on;
	status = "okay";
};

/* LED configuration - for RGB test */
&npm1300_ek_leds {
    compatible = "nordic,npm1300-led";
    nordic,led0-mode = "host";  /* Red LED - controlled by host */
    nordic,led1-mode = "host";  /* Green LED - controlled by host */
    nordic,led2-mode = "host";  /* Blue LED - controlled by host */
    status = "okay";
};

/* Charger configuration - for fuel gauge */
&npm1300_ek_charger {
    status = "okay";
};

/* ─── EMS stimulation engine ─── */

/* nrfx owns PWM20/21/22 directly (EasyDMA) — disable the Zephyr PWM driver
 * nodes so they don't claim the peripherals/pins. */
&pwm20 { status = "disabled"; };
&pwm21 { status = "disabled"; };
&pwm22 { status = "disabled"; };

/* EMS inductor-discharge safety GPIO — P0.0 (driven directly via nrf_gpio). */
/ {
    test_ems_gpios {
        compatible = "gpio-leds";
        test_ems_gpio: test-ems {
            gpios = <&gpio0 0 GPIO_ACTIVE_HIGH>;
        };
    };
};
